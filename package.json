{
  "name": "active-operating-system",
  "version": "0.1.0",
  "description": "ACTIVE Operating System - real estate operating layer (Payment Plans, RBAC, CRM, Sales, Inventory, Finance, Brokers)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start:prod": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test $(find src -name '*.test.ts')"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
