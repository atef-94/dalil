# Copy to .env and fill in real values. Never commit the real .env.

NODE_ENV=development
PORT=3000

# HMAC signing secret for auth tokens. Required in production — the server
# refuses to boot under NODE_ENV=production without a real value here.
TOKEN_SECRET=

# Where the real, on-disk SQLite database file lives (see
# src/infra/sqlite-repository.ts). Defaults to ./data/active-os.db if unset;
# the directory is created automatically. This is the actual persistence
# layer today — data survives process restarts.
SQLITE_PATH=./data/active-os.db

# Not yet connected to the running app (see prisma/schema.prisma) — a future
# migration path to Postgres, unrelated to SQLITE_PATH above. The app warns,
# but still boots, if this is unset.
DATABASE_URL=postgres://user:password@localhost:5432/active_os

# Comma-separated list of allowed CORS origins. Empty = same-origin only.
ALLOWED_ORIGINS=

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
