# Copy to .env and fill in real values. Never commit the real .env.

NODE_ENV=development
PORT=3000

# HMAC signing secret for auth tokens. Required in production — the server
# refuses to boot under NODE_ENV=production without a real value here.
TOKEN_SECRET=

# Key used to encrypt Automation Engine secrets at rest (webhook_call
# credentials — see src/infra/security.ts encryptSecret/decryptSecret).
# Falls back to TOKEN_SECRET when unset, which is fine for dev; production
# should set this separately so rotating one secret never invalidates the
# other.
SECRET_STORE_KEY=

# Where the real, on-disk SQLite database file lives (see
# src/infra/sqlite-repository.ts). Defaults to ./data/active-os.db if unset;
# the directory is created automatically. This is the actual persistence
# layer today — data survives process restarts.
SQLITE_PATH=./data/active-os.db

# Not yet connected to the running app (see prisma/schema.prisma) — a future
# migration path to Postgres, unrelated to SQLITE_PATH above. The app warns,
# but still boots, if this is unset.
DATABASE_URL=postgres://user:password@localhost:5432/active_os

# Comma-separated list of allowed CORS origins. Empty = same-origin only.
ALLOWED_ORIGINS=

# Whether to trust the X-Forwarded-For header for rate-limiting/logging the
# client's IP. Defaults to false (unset/anything but "true") — with it
# false, the real socket address is always used, which is correct for a
# direct-exposed deployment. Only set this to "true" when the app is
# genuinely reachable ONLY through a trusted reverse proxy that sets this
# header itself (e.g. Railway's edge) — otherwise any external caller can
# set an arbitrary value on this header and get a fresh rate-limit bucket on
# every request, defeating both the global limiter and the auth/login
# brute-force limiter.
TRUST_PROXY=false

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Automation Engine tuning. Base delay (ms) before a retried step attempt,
# doubled each attempt up to a 30s cap; and the max workflow runs executed
# concurrently, process-wide (extra triggers queue instead of piling up
# unbounded concurrent work).
AUTOMATION_RETRY_BASE_DELAY_MS=300
AUTOMATION_MAX_CONCURRENT_RUNS=10
