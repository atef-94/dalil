  "spelling_variation_rules": [
    {
      "rule_id": "digit_letter_alternation",
      "description": "Same word rendered with digit (3,7,2,5,9,6) vs. Latin-letter approximation for the same Arabic phoneme.",
      "example": { "digit_form": "3ayez", "letter_form": "aayez" }
    },
    {
      "rule_id": "vowel_elision",
      "description": "Short/medial vowels frequently dropped in fast informal typing.",
      "example": { "full": "momken", "elided": "mmkn" }
    },
    {
      "rule_id": "letter_doubling",
      "description": "Emphatic or careless doubling of a consonant/vowel.",
      "example": { "base": "tamam", "doubled": "tamaam" }
    },
    {
      "rule_id": "definite_article_fusion",
      "description": "'ال' (el/al) fused onto the following word with no space, a very common WhatsApp pattern.",
      "example": { "separated": "el se3r", "fused": "else3r" }
    },
    {
      "rule_id": "english_word_substitution",
      "description": "A real-estate/business English loanword used in place of the Arabic term even inside an otherwise Arabic/Franco sentence (e.g. 'view', 'cash', 'delivery', 'offer', 'meeting').",
      "example": { "arabic": "عايز اعرف الفيو", "mixed": "3ayez a3raf el view" }
    },
    {
      "rule_id": "keyboard_switch_typo",
      "description": "One or two characters typed while the keyboard was still set to the other script/layout, producing a garbled token (e.g. 'shaqة' or a stray Arabic letter mid-Latin word). Used sparingly, only in the typing_errors_and_keyboard_switch category.",
      "example": { "intended": "شقة", "typo": "شقه" }
    },
    {
      "rule_id": "common_arabic_misspelling",
      "description": "Native-script misspellings independent of Franco: ة/ه confusion, ا/إ/أ confusion, ي/ى confusion.",
      "example": { "correct": "شقة", "misspelled": "شقه" }
    }
  ]
}
