{
  "_meta": {
    "description": "Franco-Arabic (Arabizi) transliteration system for the ACTIVE AI dataset: a letter-level phonetic mapping plus a curated word dictionary of Egyptian real-estate/CRM/sales vocabulary with realistic Franco spelling variants. Used by the generation pipeline (active_ai_language_dataset.jsonl) to render Arabic-authored templates into Franco/mixed variants and to inject realistic typing errors.",
    "provenance_note": "Letter mappings reflect widely-attested Egyptian Franco-Arabic conventions (3=ع, 7=ح, 2=ء/ق, etc.). Word-level variants are a mix of commonly-seen spellings and reasonable linguistic variation generated from the letter map's own rules — see active_ai_dataset_report.md's Data Provenance section for the verified/reasonable-variation/synthetic breakdown. No frequency/popularity ranking is claimed for any specific variant."
  },
  "letter_map": [
    { "arabic": "ء", "franco": ["2", "'"], "notes": "hamza" },
    { "arabic": "ا", "franco": ["a", ""], "notes": "alef, often dropped medially" },
    { "arabic": "ب", "franco": ["b"], "notes": "" },
    { "arabic": "ت", "franco": ["t"], "notes": "" },
    { "arabic": "ث", "franco": ["th", "s", "t"], "notes": "Egyptian colloquial often realizes as س/ت" },
    { "arabic": "ج", "franco": ["g", "j"], "notes": "Egyptian ج is hard g" },
    { "arabic": "ح", "franco": ["7", "h"], "notes": "" },
    { "arabic": "خ", "franco": ["5", "kh", "7'"], "notes": "" },
    { "arabic": "د", "franco": ["d"], "notes": "" },
    { "arabic": "ذ", "franco": ["z", "th", "d"], "notes": "" },
    { "arabic": "ر", "franco": ["r"], "notes": "" },
    { "arabic": "ز", "franco": ["z"], "notes": "" },
    { "arabic": "س", "franco": ["s"], "notes": "" },
    { "arabic": "ش", "franco": ["sh", "ch"], "notes": "" },
    { "arabic": "ص", "franco": ["s", "9"], "notes": "" },
    { "arabic": "ض", "franco": ["d", "9'"], "notes": "" },
    { "arabic": "ط", "franco": ["t", "6"], "notes": "" },
    { "arabic": "ظ", "franco": ["z", "6'"], "notes": "" },
    { "arabic": "ع", "franco": ["3"], "notes": "the canonical Franco-Arabic digit" },
    { "arabic": "غ", "franco": ["3'", "gh", "g"], "notes": "" },
    { "arabic": "ف", "franco": ["f"], "notes": "" },
    { "arabic": "ق", "franco": ["2", "q", "k"], "notes": "Cairene colloquial often glottalizes ق to hamza (2)" },
    { "arabic": "ك", "franco": ["k"], "notes": "" },
    { "arabic": "ل", "franco": ["l"], "notes": "" },
    { "arabic": "م", "franco": ["m"], "notes": "" },
    { "arabic": "ن", "franco": ["n"], "notes": "" },
    { "arabic": "ه", "franco": ["h"], "notes": "" },
    { "arabic": "و", "franco": ["w", "o", "u"], "notes": "" },
    { "arabic": "ي", "franco": ["y", "i", "ee"], "notes": "" },
    { "arabic": "ة", "franco": ["a", "et", "ah"], "notes": "taa marbuta" },
    { "arabic": "ال", "franco": ["el", "al", "l"], "notes": "definite article, often elided as a prefix" }
  ],
